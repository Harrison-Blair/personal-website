# Environment Variables Template
# Copy this file to .env.local and fill in your actual values.

# Resend API Key for sending emails from the contact form
RESEND_API_KEY=your_resend_api_key_here
# Destination email address for receiving contact form submissions (server-side)
RESEND_DESTINATION_EMAIL=your_destination@email.com
# Public email address shown in the "Email Me" mailto link
NEXT_PUBLIC_RESEND_DESTINATION_EMAIL=your_destination@email.com